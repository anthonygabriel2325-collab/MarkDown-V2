    function parseStyleAttributes(attrs) {
        const style = [];
        const data = [];

        for (const [key, value] of Object.entries(attrs)) {
            const cssName = cssPropertyName(key);

            if (cssName) {
                const safeValue = value.replace(/["']/g, "");

                style.push(
                    cssName + ":" + safeValue
                );

                continue;
            }

            if (key === "hover-color") {
                data.push(
                    'data-hover-color="' +
                    escapeAttr(value) +
                    '"'
                );

                continue;
            }

            if (key === "hover-size") {
                data.push(
                    'data-hover-size="' +
                    escapeAttr(value) +
                    '"'
                );

                continue;
            }

            if (key === "hover-text") {
                data.push(
                    'data-hover-text="' +
                    escapeAttr(value) +
                    '"'
                );

                continue;
            }

            if (key === "animate") {
                data.push(
                    'data-md2-animation="' +
                    escapeAttr(value) +
                    '"'
                );

                continue;
            }

            if (key === "duration") {
                data.push(
                    'data-md2-duration="' +
                    escapeAttr(value) +
                    '"'
                );
            }
        }

        return {
            style: style.length
                ? ' style="' +
                  escapeAttr(style.join(";")) +
                  '"'
                : "",

            data: data.length
                ? " " + data.join(" ")
                : ""
        };
