<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Markdown V2 (MD2) - Especificação & Playground</title>
    <!-- Utilizando marked.js como fallback para o Markdown Clássico (Progressive Enhancement) -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        /* =========================================
           ESTILOS DA INTERFACE (PLAYGROUND)
           ========================================= */
        :root {
            --bg-color: #1e1e2e;
            --panel-bg: #282a36;
            --text-color: #f8f8f2;
            --accent: #bd93f9;
            --border: #44475a;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        header {
            padding: 1rem 2rem;
            background-color: var(--panel-bg);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header h1 { font-size: 1.5rem; color: var(--accent); }
        .container {
            display: flex;
            flex: 1;
            overflow: hidden;
        }
        .panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border);
        }
        .panel-header {
            padding: 0.5rem 1rem;
            background: #21222c;
            font-size: 0.85rem;
            font-weight: bold;
            color: #8be9fd;
            text-transform: uppercase;
        }
        textarea {
            flex: 1;
            width: 100%;
            background-color: transparent;
            color: inherit;
            border: none;
            padding: 1rem;
            font-family: "Fira Code", monospace;
            font-size: 14px;
            resize: none;
            outline: none;
        }
        #preview {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
            background-color: #ffffff; /* Preview em fundo claro para contraste */
            color: #333333;
            font-family: "Inter", sans-serif;
            line-height: 1.6;
        }

        /* =========================================
           ESTILOS NATIVOS DA BIBLIOTECA MD2
           ========================================= */
        
        /* Inline Elements */
        mark.md2-highlight { background-color: #ffd700; color: #000; padding: 0 4px; border-radius: 3px; }
        u.md2-underline { text-decoration: underline; text-decoration-color: #bd93f9; text-decoration-thickness: 2px; }
        kbd.md2-kbd { background-color: #eee; border: 1px solid #b4b4b4; border-radius: 3px; padding: 2px 5px; font-family: monospace; font-size: 0.9em; box-shadow: 0 1px 1px rgba(0,0,0,.2); color: #333; }
        
        /* Spoilers */
        .md2-spoiler {
            background-color: #d1d5db;
            color: transparent;
            text-shadow: 0 0 10px rgba(0,0,0,0.5);
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 4px;
            padding: 0 4px;
            user-select: none;
        }
        .md2-spoiler.revealed {
            background-color: transparent;
            color: inherit;
            text-shadow: none;
        }

        /* Estilos e Atributos Universais */
        .md2-styled { display: inline-block; position: relative; transition: all 0.2s; }
        .md2-styled[data-hover-text]:hover::after {
            content: attr(data-hover-text);
            position: absolute;
            bottom: 100%; left: 50%;
            transform: translateX(-50%);
            background: #333; color: #fff;
            padding: 4px 8px; border-radius: 4px;
            font-size: 12px; white-space: nowrap;
            pointer-events: none;
        }

        /* Animações Nativas */
        .md2-anim-rainbow {
            background-image: linear-gradient(to left, violet, indigo, blue, green, yellow, orange, red);
            -webkit-background-clip: text; color: transparent;
            animation: rainbow-anim 5s linear infinite;
            background-size: 200% 200%;
        }
        @keyframes rainbow-anim { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }
        
        .md2-anim-pulse { animation: pulse-anim 1s infinite; }
        @keyframes pulse-anim { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.05); } }
        
        .md2-anim-typewriter {
            overflow: hidden; white-space: nowrap; border-right: 2px solid;
            animation: typing 3.5s steps(40, end), blink-caret .75s step-end infinite;
        }
        @keyframes typing { from { width: 0 } to { width: 100% } }
        @keyframes blink-caret { from, to { border-color: transparent } 50% { border-color: currentColor; } }

        /* Blocos (Admonitions, Book, Tabs, Columns) */
        .md2-book {
            font-family: "Georgia", serif;
            padding: 2rem;
            margin: 1.5rem 0;
            border-radius: 8px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.05), 0 4px 6px rgba(0,0,0,0.1);
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        .md2-callout {
            padding: 1rem 1.5rem;
            margin: 1rem 0;
            border-radius: 0 8px 8px 0;
            border-left: 5px solid;
        }
        .md2-callout p { margin: 0; }
        .md2-callout-info { background-color: #e0f2fe; border-color: #0284c7; color: #0369a1; }
        .md2-callout-danger { background-color: #fee2e2; border-color: #dc2626; color: #991b1b; }

        .md2-columns { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1rem 0; }
        .md2-column { flex: 1; }

        .md2-tabs { border: 1px solid #ccc; border-radius: 6px; overflow: hidden; margin: 1rem 0; }
        .md2-tab-headers { display: flex; background: #f1f1f1; border-bottom: 1px solid #ccc; }
        .md2-tab-header { padding: 10px 15px; cursor: pointer; border-right: 1px solid #ccc; font-weight: bold; }
        .md2-tab-header.active { background: #fff; border-bottom: 2px solid #0284c7; margin-bottom: -1px; }
        .md2-tab-content { display: none; padding: 1rem; }
        .md2-tab-content.active { display: block; }

        .md2-accordion { margin: 1rem 0; border: 1px solid #ddd; border-radius: 6px; }
        .md2-accordion summary { font-weight: bold; cursor: pointer; padding: 10px; background: #f9f9f9; border-radius: 6px; }
        .md2-accordion .content { padding: 10px; border-top: 1px solid #ddd; }

        /* Mídia */
        .md2-media { max-width: 100%; border-radius: 8px; margin: 1rem 0; display: block; }
        .md2-icon { display: inline-block; width: 1em; height: 1em; background-color: currentColor; -webkit-mask-size: cover; mask-size: cover; vertical-align: middle; }
        
        /* Tabela Inteligente Básica */
        .md2-smart-table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-family: monospace; }
        .md2-smart-table th, .md2-smart-table td { border: 1px solid #ccc; padding: 8px; }
        .md2-smart-table th { background-color: #f4f4f4; }
    </style>
</head>
