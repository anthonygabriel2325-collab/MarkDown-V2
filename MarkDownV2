    function mergeOptions(options) {
        return Object.assign({}, defaultOptions, options || {});
    }

    function injectStyles() {
        if (typeof document === "undefined") return;
        if (document.getElementById("md2-library-styles")) return;

        const style = document.createElement("style");
        style.id = "md2-library-styles";
        style.textContent = CSS;

        document.head.appendChild(style);
    }

    function escapeHtml(value) {
        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function escapeAttr(value) {
        return escapeHtml(value).replace(/`/g, "&#96;");
    }

    function parseFrontMatter(source) {
        const match = String(source).match(
            /^\uFEFF?---\s*\r?\n([\s\S]*?)\r?\n---\s*(?:\r?\n|$)/
        );

        if (!match) {
            return {
                attributes: {},
                body: String(source)
            };
        }

        const attributes = {};

        for (const line of match[1].split(/\r?\n/)) {
            const separator = line.indexOf(":");

            if (separator < 0) {
                continue;
            }

            const key = line.slice(0, separator).trim();
            let value = line.slice(separator + 1).trim();

            if (
                (value.startsWith('"') && value.endsWith('"')) ||
                (value.startsWith("'") && value.endsWith("'"))
            ) {
                value = value.slice(1, -1);
            } else if (/^(true|false)$/i.test(value)) {
                value = value.toLowerCase() === "true";
            } else if (/^-?\d+(?:\.\d+)?$/.test(value)) {
                value = Number(value);
            }

            if (key) {
                attributes[key] = value;
            }
        }

        return {
            attributes,
            body: String(source).slice(match[0].length)
        };
    }

    function replaceVariables(text, attributes) {
        return text.replace(
            /\{\{\s*([\w.-]+)\s*\}\}/g,
            function (_, key) {
                const value = key
                    .split(".")
                    .reduce(
                        (obj, part) =>
                            obj == null ? undefined : obj[part],
                        attributes
                    );

                return value == null ? "" : String(value);
            }
        );
    }

    function parseAttributes(input) {
        const attrs = {};

        const re =
            /([A-Za-z_:][\w:.-]*)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s]+))/g;

        let match;

        while ((match = re.exec(input))) {
            attrs[match[1]] =
                match[2] ??
                match[3] ??
                match[4] ??
                "";
        }

        return attrs;
    }

    function cssPropertyName(name) {
        const map = {
            color: "color",
            background: "background",
            "background-color": "backgroundColor",
            size: "fontSize",
            "font-size": "fontSize",
            font: "fontFamily",
            weight: "fontWeight",
            "font-weight": "fontWeight",
            style: "fontStyle",
            "letter-spacing": "letterSpacing",
            "word-spacing": "wordSpacing",
            "text-decoration": "textDecoration",
            "text-align": "textAlign",
            stroke: "webkitTextStroke",
            opacity: "opacity",
            transform: "transform",
            "border-radius": "borderRadius",
            padding: "padding",
            margin: "margin"
        };

        return map[name] || null;
