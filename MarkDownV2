    function applyAnimatedAttributes(html, attrs) {
        if (!attrs.animate) {
            return html;
        }

        const animation = String(
            attrs.animate
        ).toLowerCase();

        const allowed = {
            rainbow: "md2-anim-rainbow",
            pulse: "md2-anim-pulse",
            typewriter: "md2-anim-typewriter"
        };

        if (!allowed[animation]) {
            return html;
        }

        const duration = attrs.duration
            ? ' style="animation-duration:' +
              escapeAttr(attrs.duration) +
              '"'
            : "";

        return (
            '<span class="' +
            allowed[animation] +
            '"' +
            duration +
            ">" +
            html +
            "</span>"
        );
    }

    function parseInline(input, state) {
        let text = String(input);

        const placeholders = [];

        const stash = (html) => {
            const token =
                "\u0000MD2_" +
                placeholders.length +
                "\u0000";

            placeholders.push(html);

            return token;
        };

        text = text.replace(
            /```([\s\S]*?)```/g,
            (_, code) =>
                stash(
                    '<code class="md2-code">' +
                    escapeHtml(code.trim()) +
                    "</code>"
                )
        );

        text = text.replace(
            /`([^`\n]+)`/g,
            (_, code) =>
                stash(
                    "<code>" +
                    escapeHtml(code) +
                    "</code>"
                )
        );

        text = replaceVariables(
            text,
            state.attributes
        );

        if (
            state.options.sanitize &&
            !state.options.allowRawHtml
        ) {
            text = escapeHtml(text);
        }

        text = text.replace(
            /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"([^"]*)")?\)/g,
            function (_, alt, src, title) {
                const titleAttr = title
                    ? ' title="' +
                      escapeAttr(title) +
                      '"'
                    : "";

                return stash(
                    '<img class="md2-media" src="' +
                    escapeAttr(src) +
                    '" alt="' +
                    escapeAttr(alt) +
                    '"' +
                    titleAttr +
                    ">"
                );
            }
        );

        text = text.replace(
            /\[([^\]\n]+)\]\{([^}]+)\}/g,
            function (_, content, rawAttrs) {
                const attrs =
                    parseAttributes(rawAttrs);

                const style =
                    parseStyleAttributes(attrs);

                let inner =
                    parseInline(
                        content,
                        state
                    );

                inner =
                    applyAnimatedAttributes(
                        inner,
                        attrs
                    );

                const cls = [
                    "md2-styled"
                ];

                if (
                    attrs.animate &&
                    [
                        "rainbow",
                        "pulse",
                        "typewriter"
                    ].includes(
                        String(
                            attrs.animate
                        ).toLowerCase()
                    )
                ) {
                    cls.push(
                        "md2-animated-wrapper"
                    );
                }

                return (
                    '<span class="' +
                    cls.join(" ") +
                    '"' +
                    style.style +
                    style.data +
                    ">" +
                    inner +
                    "</span>"
                );
            }
        );

        text = text.replace(
            /\|\|\[([^\]]+)\]\|\|/g,
            (_, content) =>
                stash(
                    '<span class="md2-spoiler" tabindex="0" role="button" aria-expanded="false">' +
                    parseInline(
                        content,
                        state
                    ) +
                    "</span>"
                )
        );

        text = text.replace(
            /\[\[([^\]]+)\]\]/g,
            (_, content) =>
                "<kbd class=\"md2-kbd\">" +
                content +
                "</kbd>"
        );

        text = text.replace(
            /==([^=\n]+)==/g,
            '<mark class="md2-highlight">$1</mark>'
        );

        text = text.replace(
            /__([^_\n]+)__/g,
            '<u class="md2-underline">$1</u>'
        );

        text = text.replace(
            /~~([^~\n]+)~~/g,
            "<del>$1</del>"
        );

        text = text.replace(
            /\*\*([^*\n]+)\*\*/g,
            "<strong>$1</strong>"
        );

        text = text.replace(
            /\*([^*\n]+)\*/g,
            "<em>$1</em>"
        );

        text = text.replace(
            /_([^_\n]+)_/g,
            "<em>$1</em>"
        );

        text = text.replace(
            /(?<!\w)\^([^^\n]+)\^/g,
            "<sup>$1</sup>"
        );

        text = text.replace(
            /(?<!\w)~([^~\n]+)~/g,
            "<sub>$1</sub>"
        );

        text = text.replace(
            /\[([^\]\n]+)\]\((https?:\/\/[^)\s]+)\)/g,
            '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
        );

        text = text.replace(
            /\u0000MD2_(\d+)\u0000/g,
            (_, index) =>
                placeholders[Number(index)] || ""
        );

        return text;
    }

    function parseList(lines, index, state) {
        const first = lines[index];

        const ordered =
            /^\s*\d+\.\s+/.test(first);

        const marker = ordered
            ? /^\s*\d+\.\s+/
            : /^\s*[-*+]\s+/;

        const items = [];

        while (
            index < lines.length &&
            marker.test(lines[index])
        ) {
            items.push(
                lines[index].replace(
                    marker,
                    ""
                )
            );

            index++;
        }

        const tag = ordered ? "ol" : "ul";

        return {
            html:
                "<" +
                tag +
                ">" +
                items
                    .map(
                        item =>
                            "<li>" +
                            parseInline(
                                item,
                                state
                            ) +
                            "</li>"
                    )
                    .join("") +
                "</" +
                tag +
                ">",

            index
        };
    }

    function parseTable(lines, index, state) {
        if (index + 1 >= lines.length) {
            return null;
        }

        if (
            !/\|/.test(lines[index]) ||
            !/^\s*\|?[\s:|-]+\|/.test(
                lines[index + 1]
            )
        ) {
            return null;
        }

        const splitRow = line =>
            line
                .trim()
                .replace(/^\|/, "")
                .replace(/\|$/, "")
                .split("|")
                .map(
                    cell =>
                        cell.trim()
                );

        const headers =
            splitRow(lines[index]);

        index += 2;

        const rows = [];

        while (
            index < lines.length &&
            /\|/.test(lines[index]) &&
            lines[index].trim() !== ""
        ) {
            rows.push(
                splitRow(
                    lines[index]
                )
            );

            index++;
        }

        const head =
            "<tr>" +
            headers
                .map(
                    cell =>
                        "<th>" +
                        parseInline(
                            cell,
                            state
                        ) +
                        "</th>"
                )
                .join("") +
            "</tr>";

        const body =
            rows
                .map(
                    row =>
                        "<tr>" +
                        headers
                            .map(
                                (_, i) =>
                                    "<td>" +
                                    parseInline(
                                        row[i] ??
                                            "",
                                        state
                                    ) +
                                    "</td>"
                            )
                            .join("") +
                        "</tr>"
                )
                .join("");

        return {
            html:
                '<table class="md2-smart-table">' +
                "<thead>" +
                head +
                "</thead>" +
                "<tbody>" +
                body +
                "</tbody>" +
                "</table>",

            index
        };
    }

    function parseFencedBlock(
        lines,
        index,
        state
    ) {
        const opening =
            lines[index].match(
                /^:::(\w+)?(?:\s+\{([^}]*)\})?\s*$/
            );

        if (!opening) {
            return null;
        }

        const type =
            (
                opening[1] ||
                "container"
            ).toLowerCase();

        const rawAttrs =
            opening[2] || "";

        const attrs =
            parseAttributes(
                rawAttrs
            );

        const content = [];

        let i = index + 1;
        let depth = 1;

        while (i < lines.length) {
            if (
                /^:::(?:\s*)$/.test(
                    lines[i]
                )
            ) {
                depth--;

                if (depth === 0) {
                    break;
                }
            } else if (
                /^:::\w+/.test(
                    lines[i]
                )
            ) {
                depth++;
            }

            content.push(
                lines[i]
            );

            i++;
        }

        if (i >= lines.length) {
            return null;
        }

        const inner =
            parseBlocks(
                content.join("\n"),
                state
            ).html;

        if (
            type === "info" ||
            type === "danger" ||
            type === "success" ||
            type === "warning"
        ) {
            return {
                html:
                    '<aside class="md2-callout md2-callout-' +
                    type +
                    '">' +
                    inner +
                    "</aside>",

                index: i + 1
            };
        }

        if (type === "book") {
            const theme =
                attrs.theme
                    ? " md2-book-" +
                      String(
                          attrs.theme
                      )
                          .toLowerCase()
                          .replace(
                              /[^a-z0-9_-]/g,
                              ""
                          )
                    : "";

            const font =
                attrs.font
                    ? ' style="font-family:' +
                      escapeAttr(
                          attrs.font.replace(
                              /["']/g,
                              ""
                          )
                      ) +
                      '"'
                    : "";

            return {
                html:
                    '<section class="md2-book' +
                    theme +
                    '"' +
                    font +
                    ">" +
                    inner +
                    "</section>",

                index: i + 1
            };
        }

        if (type === "accordion") {
            const title =
                attrs.title
                    ? escapeHtml(
                          attrs.title
                      )
                    : "Detalhes";

            return {
                html:
                    '<details class="md2-accordion">' +
                    "<summary>" +
                    title +
                    "</summary>" +
                    '<div class="md2-accordion-content">' +
                    inner +
                    "</div>" +
                    "</details>",

                index: i + 1
            };
        }

        if (type === "columns") {
            const columns = [];
            let current = [];

            for (
                const line of content
            ) {
                if (
                    /^:::column\s*$/.test(
                        line.trim()
                    )
                ) {
                    if (
                        current.length
                    ) {
                        columns.push(
                            current.join("\n")
                        );
                    }

                    current = [];
                    continue;
                }

                current.push(
                    line
                );
            }

            if (current.length) {
                columns.push(
                    current.join("\n")
                );
            }

            const columnHtml =
                columns.length
                    ? columns
                          .map(
                              col =>
                                  '<div class="md2-column">' +
                                  parseBlocks(
                                      col,
                                      state
                                  ).html +
                                  "</div>"
                          )
                          .join("")
                    : '<div class="md2-column">' +
                      inner +
                      "</div>";

            return {
                html:
                    '<div class="md2-columns">' +
                    columnHtml +
                    "</div>",

                index: i + 1
            };
        }

        if (type === "tabs") {
            const tabs = [];

            let currentTitle = null;
            let currentLines = [];

            for (
                const line of content
            ) {
                const tabMatch =
                    line.match(
                        /^@tab\s+(.+)$/
                    );

                if (tabMatch) {
                    if (
                        currentTitle !==
                        null
                    ) {
                        tabs.push({
                            title:
                                currentTitle,
                            body:
                                currentLines.join(
                                    "\n"
                                )
                        });
                    }

                    currentTitle =
                        tabMatch[1].trim();

                    currentLines = [];
                } else {
                    currentLines.push(
                        line
                    );
                }
            }

            if (
                currentTitle !==
                null
            ) {
                tabs.push({
                    title:
                        currentTitle,
                    body:
                        currentLines.join(
                            "\n"
                        )
                });
            }

            const id =
                "md2-tabs-" +
                Math.random()
                    .toString(36)
                    .slice(2);

            const headers =
                tabs
                    .map(
                        (tab, n) => {
                            const active =
                                n === 0
                                    ? " active"
                                    : "";

                            return (
                                '<button type="button" class="md2-tab-header' +
                                active +
                                '" data-md2-tab="' +
                                id +
                                "-" +
                                n +
                                '">' +
                                escapeHtml(
                                    tab.title
                                ) +
                                "</button>"
                            );
                        }
                    )
                    .join("");

            const bodies =
                tabs
                    .map(
                        (tab, n) => {
                            const active =
                                n === 0
                                    ? " active"
                                    : "";

                            return (
                                '<div class="md2-tab-content' +
                                active +
                                '" id="' +
                                id +
                                "-" +
                                n +
                                '">' +
                                parseBlocks(
                                    tab.body,
                                    state
                                ).html +
                                "</div>"
                            );
                        }
                    )
                    .join("");

            return {
                html:
                    '<section class="md2-tabs" data-md2-tabs="' +
                    id +
                    '">' +
                    '<div class="md2-tab-headers">' +
                    headers +
                    "</div>" +
                    bodies +
                    "</section>",

                index: i + 1
            };
        }

        return {
            html:
                '<div class="md2-block md2-' +
                escapeAttr(type) +
                '">' +
                inner +
                "</div>",

            index: i + 1
        };
    }

    function parseBlocks(
        source,
        state
    ) {
        const lines =
            source
                .replace(
                    /\r\n?/g,
                    "\n"
                )
                .split("\n");

        const html = [];
        let i = 0;

        while (i < lines.length) {
            const line = lines[i];

            if (!line.trim()) {
                i++;
                continue;
            }

            if (/^\s*```/.test(line)) {
                const lang =
                    line
                        .replace(
                            /^\s*```/,
                            ""
                        )
                        .trim();

                const code = [];

                i++;

                while (
                    i < lines.length &&
                    !/^\s*```/.test(
                        lines[i]
                    )
                ) {
                    code.push(
                        lines[i]
                    );

                    i++;
                }

                if (
                    i < lines.length
                ) {
                    i++;
                }

                const langClass =
                    lang
                        ? ' data-language="' +
                          escapeAttr(
                              lang
                          ) +
                          '"'
                        : "";

                html.push(
                    '<pre class="md2-code"' +
                    langClass +
                    "><code>" +
                    escapeHtml(
                        code.join("\n")
                    ) +
                    "</code></pre>"
                );

                continue;
            }

            const fenced =
                parseFencedBlock(
                    lines,
                    i,
                    state
                );

            if (fenced) {
                html.push(
                    fenced.html
                );

                i =
                    fenced.index;

                continue;
            }

            const table =
                parseTable(
                    lines,
                    i,
                    state
                );

            if (table) {
                html.push(
                    table.html
                );

                i =
                    table.index;

                continue;
            }

            const heading =
                line.match(
                    /^\s{0,3}(#{1,6})\s+(.+?)\s*#*\s*$/
                );

            if (heading) {
                const level =
                    heading[1].length;

                html.push(
                    "<h" +
                    level +
                    ">" +
                    parseInline(
                        heading[2],
                        state
                    ) +
                    "</h" +
                    level +
                    ">"
                );

                i++;

                continue;
            }

            const quote =
                line.match(
                    /^\s*>\s?(.*)$/
                );

            if (quote) {
                const quoteLines = [];

                while (
                    i < lines.length
                ) {
                    const m =
                        lines[i].match(
                            /^\s*>\s?(.*)$/
                        );

                    if (!m) {
                        break;
                    }

                    quoteLines.push(
                        m[1]
                    );

                    i++;
                }

                html.push(
                    "<blockquote>" +
                    parseBlocks(
                        quoteLines.join(
                            "\n"
                        ),
                        state
                    ).html +
                    "</blockquote>"
                );

                continue;
            }

            if (
                /^\s*(?:[-*+]\s+|\d+\.\s+)/.test(
                    line
                )
            ) {
                const list =
                    parseList(
                        lines,
                        i,
                        state
                    );

                html.push(
                    list.html
                );

                i =
                    list.index;

                continue;
            }

            if (
                /^\s*---+\s*$/.test(
                    line
                )
            ) {
                html.push(
                    "<hr>"
                );

                i++;

                continue;
            }

            const paragraph = [
                line
            ];

            i++;

            while (
                i < lines.length &&
                lines[i].trim() &&
                !/^\s{0,3}(#{1,6})\s+/.test(
                    lines[i]
                ) &&
                !/^\s*```/.test(
                    lines[i]
                ) &&
                !/^:::\w*/.test(
                    lines[i]
                ) &&
                !/^\s*(?:[-*+]\s+|\d+\.\s+)/.test(
                    lines[i]
                ) &&
                !/^\s*>/.test(
                    lines[i]
                )
            ) {
                paragraph.push(
                    lines[i]
                );

                i++;
            }

            html.push(
                "<p>" +
                parseInline(
                    paragraph
                        .join("\n")
                        .replace(
                            /\n/g,
                            "<br>"
                        ),
                    state
                ) +
                "</p>"
            );
        }

        return {
            html: html.join("\n")
        };
    }

    function applyDOMBehavior(root) {
        root.addEventListener(
            "click",
            function (event) {
                const spoiler =
                    event.target.closest(
                        ".md2-spoiler"
                    );

                if (
                    spoiler &&
                    root.contains(
                        spoiler
                    )
                ) {
                    const revealed =
                        spoiler.classList.toggle(
                            "revealed"
                        );

                    spoiler.setAttribute(
                        "aria-expanded",
                        revealed
                            ? "true"
                            : "false"
                    );

                    return;
                }

                const tab =
                    event.target.closest(
                        ".md2-tab-header"
                    );

                if (
                    !tab ||
                    !root.contains(tab)
                ) {
                    return;
                }

                const tabs =
                    tab.closest(
                        ".md2-tabs"
                    );

                if (!tabs) {
                    return;
                }

                const id =
                    tab.getAttribute(
                        "data-md2-tab"
                    );

                tabs
                    .querySelectorAll(
                        ".md2-tab-header"
                    )
                    .forEach(
                        button => {
                            button.classList.toggle(
                                "active",
                                button ===
                                    tab
                            );
                        }
                    );

                tabs
                    .querySelectorAll(
                        ".md2-tab-content"
                    )
                    .forEach(
                        content => {
                            content.classList.toggle(
                                "active",
                                content.id ===
                                    id
                            );
                        }
                    );
            }
        );

        root.addEventListener(
            "keydown",
            function (event) {
                if (
                    event.key !==
                        "Enter" &&
                    event.key !== " "
                ) {
                    return;
                }

                const spoiler =
                    event.target.closest(
                        ".md2-spoiler"
                    );

                if (
                    !spoiler ||
                    !root.contains(
                        spoiler
                    )
                ) {
                    return;
                }

                event.preventDefault();

                spoiler.click();
            }
        );

        root.addEventListener(
            "mouseover",
            function (event) {
                const element =
                    event.target.closest(
                        "[data-hover-color],[data-hover-size]"
                    );

                if (
                    !element ||
                    !root.contains(
                        element
                    )
                ) {
                    return;
                }

                if (
                    element.dataset
                        .hoverColor
                ) {
                    element.dataset.md2OldColor =
                        element.style.color ||
                        "";

                    element.style.color =
                        element.dataset.hoverColor;
                }

                if (
                    element.dataset
                        .hoverSize
                ) {
                    element.dataset.md2OldSize =
                        element.style.fontSize ||
                        "";

                    element.style.fontSize =
                        element.dataset.hoverSize;
                }
            }
        );

        root.addEventListener(
            "mouseout",
            function (event) {
                const element =
                    event.target.closest(
                        "[data-hover-color],[data-hover-size]"
                    );

                if (
                    !element ||
                    !root.contains(
                        element
                    )
                ) {
                    return;
                }

                if (
                    element.dataset
                        .hoverColor
                ) {
                    element.style.color =
                        element.dataset.md2OldColor ||
                        "";
                }

                if (
                    element.dataset
                        .hoverSize
                ) {
                    element.style.fontSize =
                        element.dataset.md2OldSize ||
                        "";
                }
            }
        );

        root
            .querySelectorAll(
                "[data-md2-animation]"
            )
            .forEach(
                element => {
                    const animation =
                        element.dataset
                            .md2Animation;

                    if (
                        animation ===
                        "rainbow"
                    ) {
                        element.classList.add(
                            "md2-anim-rainbow"
                        );
                    }

                    if (
                        animation ===
                        "pulse"
                    ) {
                        element.classList.add(
                            "md2-anim-pulse"
                        );
                    }

                    if (
                        animation ===
                        "typewriter"
                    ) {
                        element.classList.add(
                            "md2-anim-typewriter"
                        );
                    }

                    if (
                        element.dataset
                            .md2Duration
                    ) {
                        element.style.animationDuration =
                            element.dataset.md2Duration;
                    }
                }
            );
    }

    function parse(
        source,
        options
    ) {
        const opts =
            mergeOptions(
                options
            );

        const frontMatter =
            parseFrontMatter(
                source
            );

        const attributes =
            frontMatter.attributes;

        const state = {
            attributes,
            options: opts
        };

        const body =
            replaceVariables(
                frontMatter.body,
                attributes
            );

        const result =
            parseBlocks(
                body,
                state
            ).html;

        return {
            html:
                '<div class="md2-root">' +
                result +
                "</div>",

            attributes,

            version: VERSION
        };
    }

    function render(
        source,
        target,
        options
    ) {
        if (
            typeof Element ===
                "undefined" ||
            !(target instanceof Element)
        ) {
            throw new TypeError(
                "MD2.render: target deve ser um Element."
            );
        }

        const opts =
            mergeOptions(
                options
            );

        if (
            opts.injectStyles
        ) {
            injectStyles();
        }

        const result =
            parse(
                source,
                opts
            );

        target.innerHTML =
            result.html;

        const root =
            target.querySelector(
                ".md2-root"
            );

        if (root) {
            applyDOMBehavior(
                root
            );
        }

        return result;
    }

    function mount(
        target,
        source,
        options
    ) {
        return render(
            source,
            target,
            options
        );
    }

    function create(
        options
    ) {
        const opts =
            mergeOptions(
                options
            );

        return {
            version:
                VERSION,

            parse: source =>
                parse(
                    source,
                    opts
                ),

            render: (
                source,
                target
            ) =>
                render(
                    source,
                    target,
                    opts
                ),

            mount: (
                target,
                source
            ) =>
                render(
                    source,
                    target,
                    opts
                )
        };
    }

    const MD2 = {
        version: VERSION,
        parse,
        render,
        mount,
        create,
        injectStyles,
        options: defaultOptions
    };

    if (
        typeof module !==
            "undefined" &&
        module.exports
    ) {
        module.exports = MD2;
    }

    global.MD2 = MD2;

})(
    typeof globalThis !==
        "undefined"
        ? globalThis
        : window
);
